# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/orkis_db

# JWT — use a long random string in production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# bcrypt work factor (12 is a good default)
BCRYPT_ROUNDS=12

# Email for the seeded Associate Dean account
DEAN_EMAIL=dean@stme.edu

# Gmail SMTP — generate an App Password at:
# Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=your.gmail@gmail.com
